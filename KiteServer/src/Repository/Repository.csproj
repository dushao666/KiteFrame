<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SqlSugarCoreNoDrive" Version="5.1.4.169" />
    <!-- 9.x 修复了 8.4.0 的已知漏洞 CVE-2024-21170 -->
    <PackageReference Include="MySql.Data" Version="9.2.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="9.0.0" />
    <!-- 数据库迁移（Flyway 式 SQL 脚本，启动时自动执行） -->
    <PackageReference Include="dbup-core" Version="6.1.1" />
    <PackageReference Include="dbup-mysql" Version="6.1.0" />
    <!-- MySQL 连接字符串解析（迁移版本表需以库名限定）；
         与 dbup-mysql 内部所用连接库一致，显式引用以固定版本（原为传递依赖） -->
    <PackageReference Include="MySqlConnector" Version="2.3.5" />
    <!-- 迁移执行器日志（与程序入口的静态 Log.* 保持一致） -->
    <PackageReference Include="Serilog" Version="4.2.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Domain\Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Sql\" />
  </ItemGroup>

  <ItemGroup>
    <!-- 迁移脚本以嵌入资源随程序集发布，启动时由 DbUp 执行；
         按 方言/年/月 分目录存放（Sql\Migrations\{MySql|PostgreSQL|...}\{年}\{月}\V00xx__描述.sql）；
         LogicalName 保证资源名与目录结构一一对应（编译器会给数字开头的目录段自动加下划线前缀） -->
    <EmbeddedResource Include="Sql\Migrations\**\*.sql">
      <LogicalName>Repository.Sql.Migrations.$([System.String]::Copy('%(RecursiveDir)').Replace('\', '.').Replace('/', '.'))%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
