{
  // 敏感配置一律通过环境变量注入（.NET 配置系统标准机制，双下划线分隔层级），
  // 不在本文件中存放任何凭据，也不使用 ${VAR} 占位符（配置系统不会展开该写法）。
  // 生产部署必须注入以下环境变量：
  //   ConnectionStrings__MySQL        数据库连接串（DatabaseType 为其他类型时注入对应键，如 ConnectionStrings__PostgreSQL）
  //   JwtSettings__SecretKey          JWT 签名密钥（不少于 32 字符，未配置时启动直接失败）
  //   ConnectionStrings__Redis        Redis 连接串（启用 Redis 缓存时需要）
  "ConnectionStrings": {
    "SQLite": "Data Source=/var/data/kite_prod.db"
  },
  "DatabaseSettings": {
    "DatabaseType": 0,
    "CommandTimeout": 60,
    "EnableSqlLog": false,
    "EnableSoftDelete": true,
    "EnableAuditFields": true
  },
  "RedisSettings": {
    "Enabled": true,
    "Database": 0,
    "CommandTimeout": 3000,
    "ConnectTimeout": 3000,
    "SyncTimeout": 3000
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning",
        "SqlSugar": "Warning",
        "Application": "Information",
        "Api": "Information",
        "Infrastructure": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "restrictedToMinimumLevel": "Warning",
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} {Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/prod-log-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 90,
          "fileSizeLimitBytes": 104857600,
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} {Level:u3}] {SourceContext} {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      },
      {
        "Name": "Logger",
        "Args": {
          "configureLogger": {
            "Filter": [
              {
                "Name": "ByIncludingOnly",
                "Args": {
                  "expression": "@l in ['Error', 'Fatal']"
                }
              }
            ],
            "WriteTo": [
              {
                "Name": "File",
                "Args": {
                  "path": "logs/errors/error-.txt",
                  "rollingInterval": "Day",
                  "retainedFileCountLimit": 90,
                  "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} {Level:u3}] {SourceContext}{NewLine}消息: {Message:lj}{NewLine}异常详情: {Exception}{NewLine}属性: {Properties:j}{NewLine}========================================{NewLine}"
                }
              }
            ]
          }
        }
      }
    ]
  },
  "JwtSettings": {
    "Issuer": "KiteServer",
    "Audience": "KiteClient",
    "ExpiryMinutes": 30,
    "RefreshTokenExpiryDays": 3
  },
  "CacheSettings": {
    "EnableMemoryCache": true,
    "EnableRedisCache": true,
    "DefaultExpirationMinutes": 60,
    "SlidingExpirationMinutes": 30,
    "MaxMemoryCacheSizeMB": 200
  },
  "FileUploadSettings": {
    "MaxFileSize": 5242880,
    "AllowedExtensions": [ ".jpg", ".jpeg", ".png", ".pdf", ".doc", ".docx" ],
    "UploadPath": "/var/uploads/kiteserver"
  },
  "CorsSettings": {
    "Enabled": true,
    "AllowedOrigins": [ "https://yourdomain.com", "https://admin.yourdomain.com" ],
    "AllowCredentials": true,
    "AllowedMethods": [ "GET", "POST", "PUT", "DELETE" ],
    "AllowedHeaders": [ "Content-Type", "Authorization" ],
    "ExposedHeaders": [ "X-Total-Count" ]
  },
  "HealthCheckSettings": {
    "Enabled": true,
    "EnableDatabaseCheck": true,
    "EnableRedisCheck": true,
    "TimeoutSeconds": 5,
    "DetailedErrors": false
  },
  "RateLimitSettings": {
    "Enabled": true,
    "PolicyType": "Sliding",
    "EnableIpRateLimit": true,
    "EnableUserRateLimit": true,
    "StatusCode": 429,
    "Message": "请求过于频繁，请稍后再试",
    "FixedWindow": {
      "Window": 60,
      "PermitLimit": 60,
      "QueueLimit": 0
    },
    "SlidingWindow": {
      "Window": 60,
      "PermitLimit": 60,
      "SegmentsPerWindow": 6,
      "QueueLimit": 0
    },
    "TokenBucket": {
      "TokenLimit": 60,
      "TokensPerPeriod": 10,
      "ReplenishmentPeriod": 10,
      "QueueLimit": 0
    },
    "Concurrency": {
      "PermitLimit": 50,
      "QueueLimit": 10
    }
  },

  "SwaggerSettings": {
    "Enabled": false,
    "EnableInProduction": false,
    "Servers": []
  }
}
