# docker-compose 环境变量模板
# 使用方法：复制为同目录下的 .env 文件，并将所有值修改为强随机密码
# .env 已被 .gitignore 排除，禁止提交到仓库

# MySQL root 密码（仅容器内部使用）
MYSQL_ROOT_PASSWORD=change_me_strong_root_password

# MySQL 应用账户密码（API 连接数据库使用）
MYSQL_PASSWORD=change_me_strong_app_password

# Redis 密码
REDIS_PASSWORD=change_me_strong_redis_password

# JWT 签名密钥（不少于 32 字符，建议使用随机字符串；未配置时服务启动会直接失败）
JWT_SECRET_KEY=change_me_random_key_at_least_32_characters_long
